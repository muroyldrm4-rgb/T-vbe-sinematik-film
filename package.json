  "dependencies": {
    "@remotion/cli": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
