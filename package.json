{
  "name": "tovbe-donmek-icin-gec-degil",
  "version": "0.1.0",
  "private": true,
  "description": "Tövbe – Dönmek İçin Geç Değil | Remotion + TypeScript dikey sinematik video",
  "scripts": {
    "studio": "remotion studio",
    "check-media": "node scripts/check-media.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
